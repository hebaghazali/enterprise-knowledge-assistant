APP_NAME="Enterprise Knowledge Assistant API"
ENVIRONMENT="local"
DEBUG=true
API_VERSION="0.1.0"

POSTGRES_USER=eka_user
POSTGRES_PASSWORD=eka_password
POSTGRES_DB=eka_db
DATABASE_URL=postgresql+psycopg://eka_user:eka_password@localhost:5432/eka_db

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=enterprise_knowledge_chunks

UPLOAD_DIR=storage/uploads
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_QUERY_TOKENS=512
